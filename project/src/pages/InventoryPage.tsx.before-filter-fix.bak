        <div className="overflow-x-auto">
          <table className="w-full text-sm text-right border-collapse min-w-[980px]" role="grid">
            <thead>
              <tr className="bg-slate-950/50 border-b border-slate-800">
                <th className="p-4 w-12 text-center" scope="col">
                  <input
                    type="checkbox"
                    className="accent-emerald-500 rounded cursor-pointer"
                    checked={selected.size === pageItems.length && pageItems.length > 0}
                    onChange={toggleSelectAll}
                    aria-label={t('Select all', 'ØªØ­Ø¯ÙŠØ¯ Ø§Ù„ÙƒÙ„')}
                  />
                </th>
                <th scope="col" className="p-4 w-[64px] text-slate-500 font-bold uppercase text-[10px] tracking-widest">{t('Image', 'Ø§Ù„ØµÙˆØ±Ø©')}</th>
                <th scope="col" className="p-4 text-slate-500 font-bold uppercase text-[10px] tracking-widest">{t('Product Details', 'ØªÙØ§ØµÙŠÙ„ Ø§Ù„Ù…Ù†ØªØ¬')}</th>
                <th scope="col" className="p-4 text-slate-500 font-bold uppercase text-[10px] tracking-widest">{t('Category / Details', 'Ø§Ù„ØµÙ†Ù / Ø§Ù„ØªÙØ§ØµÙŠÙ„')}</th>
                <th scope="col" className="p-4 text-slate-500 font-bold uppercase text-[10px] tracking-widest">{t('Stock Level', 'Ø§Ù„Ù…Ø®Ø²ÙˆÙ†')}</th>
                <th scope="col" className="p-4 text-slate-500 font-bold uppercase text-[10px] tracking-widest">{t('Unit Price', 'Ø³Ø¹Ø± Ø§Ù„ÙˆØ­Ø¯Ø©')}</th>
                <th scope="col" className="p-4 text-slate-500 font-bold uppercase text-[10px] tracking-widest">{t('Visibility', 'Ù†Ø·Ø§Ù‚ Ø§Ù„Ø¸Ù‡ÙˆØ±')}</th>
                <th scope="col" className="p-4 text-slate-500 font-bold uppercase text-[10px] tracking-widest text-center">{t('Actions', 'Ø¥Ø¬Ø±Ø§Ø¡')}</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/50">
              {loading ? (
                <tr>
                  <td colSpan={8} className="p-20 text-center text-slate-500">
