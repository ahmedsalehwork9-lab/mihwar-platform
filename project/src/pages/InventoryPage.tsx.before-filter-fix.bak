            >
              <X size={16} />
            </button>
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {[
              { label: t('New Products', 'Ù…Ù†ØªØ¬Ø§Øª Ø¬Ø¯ÙŠØ¯Ø©'),     val: importSummary.inserted,       color: 'text-emerald-400' },
              { label: t('Updated Products', 'Ù…Ù†ØªØ¬Ø§Øª Ù…Ø­Ø¯Ù‘Ø«Ø©'), val: importSummary.updated,         color: 'text-blue-400' },
              { label: t('Skipped Rows', 'ØµÙÙˆÙ Ù…ÙØªØ®Ø·Ù‘Ø§Ø©'),    val: importSummary.skippedRows,     color: 'text-amber-400' },
              { label: t('Total Processed', 'Ø¥Ø¬Ù…Ø§Ù„ÙŠ Ø§Ù„Ù…Ø¹Ø§Ù„Ø¬Ø©'), val: importSummary.totalProcessed, color: 'text-white' },
