                          <CopyButton text={p.product_code} />
                        </div>
                      </div>
                    </td>
                    <td className="p-4 text-slate-300">
                      <div className="flex flex-col">
                        <span className="font-medium text-xs">{p.brand || 'â€”'}</span>
                        <span className="text-[10px] text-slate-500 uppercase">{p.model || 'â€”'}</span>
                      </div>
