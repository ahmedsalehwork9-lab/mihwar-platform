                      </div>
                    </td>
                    <td className="p-4 font-bold text-slate-100">
                      {p.price.toLocaleString(undefined, { minimumFractionDigits: 2 })} <span className="text-[10px] text-slate-500 font-normal">Ø±.Ø³</span>
                    </td>
                    <td className="p-4">
                      <VisibilityBadge scope={p.visibility_scope} t={t} />
                    </td>
                    <td className="p-4">
                      <div className="flex items-center justify-center gap-2">
