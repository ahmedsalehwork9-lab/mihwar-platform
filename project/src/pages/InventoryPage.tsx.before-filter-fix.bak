                          title={t('Delete', 'Ø­Ø°Ù')}
                          aria-label={t(`Delete ${p.product_name}`, `Ø­Ø°Ù ${p.product_name}`)}
                        >
                          <Trash2 size={16} />
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <PaginationControls />
      </div>

      {/* â”€â”€ Add / Edit Modal â”€â”€ */}
      {showModal && (
        <div
          className="fixed inset-0 z-[110] flex items-end sm:items-center justify-center p-0 sm:p-4 bg-slate-950/80 backdrop-blur-sm animate-in fade-in duration-200"
          role="dialog"
          aria-modal="true"
          aria-label={editItem ? t('Edit Product', 'ØªØ¹Ø¯ÙŠÙ„ Ù…Ù†ØªØ¬') : t('New Inventory Item', 'Ø¥Ø¶Ø§ÙØ© Ù…Ù†ØªØ¬ Ø¬Ø¯ÙŠØ¯')}
        >
          <div className="bg-slate-900 border border-slate-800 rounded-t-3xl sm:rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden animate-in slide-in-from-bottom-10 sm:slide-in-from-bottom-0">
            <div className="p-5 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
              <h2 className="text-lg font-black text-white">
                {editItem ? t('Edit Product', 'ØªØ¹Ø¯ÙŠÙ„ Ù…Ù†ØªØ¬') : t('New Inventory Item', 'Ø¥Ø¶Ø§ÙØ© Ù…Ù†ØªØ¬ Ø¬Ø¯ÙŠØ¯')}
              </h2>
              <button onClick={closeModal} className="p-2 text-slate-500 hover:text-white transition-colors" aria-label={t('Close', 'Ø¥ØºÙ„Ø§Ù‚')}>
                <X size={20} />
              </button>
            </div>

            <div className="p-5 space-y-4 max-h-[70vh] overflow-y-auto no-scrollbar">
              <div className="grid grid-cols-2 gap-4">

                {/* â”€â”€ Product Image Picker â”€â”€ */}
                <ImagePicker
                  value={form.product_image_url}
